AddOutputFilterByType DEFLATE text/html text/css image/svg+xml application/javascript

# The game used to live at /shark/ in an iframe and is now inlined on the home
# page. The old folder is still on the server, so send it to the home page
# rather than serving a second, orphaned copy of the game.
RewriteEngine On
# Absolute target on purpose: behind OVH's TLS terminator a relative one comes
# back as https://sharpunk.com:443/.
RewriteRule ^shark/?$ https://sharpunk.com/ [R=301,L]

# woff2, webp and mp4 are already compressed, so they are deliberately absent
# from DEFLATE above. Some shared hosts still ship an old mime.types without
# them; these lines are harmless where the type is already known.
AddType font/woff2 .woff2
AddType image/webp .webp
AddType video/mp4  .mp4

ExpiresActive On
ExpiresByType image/svg+xml "access plus 1 week"
ExpiresByType audio/mpeg "access plus 1 month"
ExpiresByType text/html "access plus 10 minutes"
# field.js is shared by all three pages, so a short expiry is mostly about
# reusing it across a visit. It is not content-hashed, so it stays short
# enough that a deploy is not stranded behind it.
ExpiresByType application/javascript "access plus 1 hour"

# None of these filenames are content-hashed, so a far-future expiry would
# strand returning visitors on a stale copy until it lapsed. The fonts are
# fixed subsets that will not change, so they take a year. The screenshots and
# Larry are both expected to be replaced, so they take a month.
ExpiresByType font/woff2 "access plus 1 year"
ExpiresByType image/webp "access plus 1 month"
ExpiresByType video/mp4 "access plus 1 month"
